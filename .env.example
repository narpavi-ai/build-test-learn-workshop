# Copy this file to .env to override defaults:  cp .env.example .env
# .env is gitignored — your local settings stay local.

# Port the Express API listens on. The web dev server's proxy reads the SAME
# variable, so changing it here moves the whole kit in one go.
# Handy when the default 3001 is already taken (e.g. Docker, another project).
API_PORT=3001
